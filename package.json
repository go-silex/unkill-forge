{
  "name": "unkill-forge",
  "version": "2.10.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run test:node && vitest run",
    "test:node": "node --test scripts/*.node-test.mjs",
    "test:coverage": "vitest run --coverage && node scripts/check-coverage-floors.mjs",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "knip": "knip --no-progress",
    "check:file-length": "node scripts/check-file-length.mjs",
    "check:worker-scope": "node scripts/check-worker-scope.mjs",
    "check:lockfile-cooldown": "node scripts/check-lockfile-cooldown.mjs",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "2.0.1",
    "@cloudflare/workers-oauth-provider": "1.2.4",
    "@modelcontextprotocol/sdk": "1.32.2",
    "hono": "4.13.20",
    "jose": "6.2.18",
    "oauth4webapi": "3.8.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@cloudflare/vitest-plugin": "1.9.0",
    "@cloudflare/workers-types": "5.20261121.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-istanbul": "5.1.1",
    "knip": "6.47.0",
    "lefthook": "2.2.2",
    "typescript": "7.0.2",
    "vitest": "5.1.1",
    "wrangler": "4.166.0"
  }
}
