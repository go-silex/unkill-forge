{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unkill-forge",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  // Add two custom_domain routes for the configured origins before opening the instance.
  "routes": [],
  "triggers": { "crons": ["0 3 * * *"] },
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  // Set FORGE_COOKIE_KEY, FORGE_SEAL_KEY and AUTH_<ID>_CLIENT_SECRET as Worker secrets.
  "vars": {
    "FORGE_NAME": "Forge",
    "LOCALE": "en",
    "TIMEZONE": "UTC",
    "BRAND": "{}",
    "READ_ORIGIN": "https://forge.example.com",
    "MANAGE_ORIGIN": "https://manage.forge.example.com",
    "ADMIN_EMAILS": "",
    "AUTH_PROVIDERS": "[{\"id\":\"github\",\"type\":\"github\",\"label\":\"GitHub\",\"clientId\":\"replace-with-client-id\"}]",
    "MCP_ALLOWED_ORIGINS": "",
    "ALLOW_DCR": "false",
    "PUBLIC_INDEX": "false",
    "ALLOW_INDEXING": "false",
    "MAX_FILES_PER_ARTEFACT": "1000",
    "MAX_BLOB_WRITES_PER_CALL": "500",
    "MAX_INLINE_BYTES": "2097152",
    "MAX_UPLOAD_BYTES": "100000000",
    "REVISION_RETENTION": "20"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "forge",
      "database_id": "replace-with-d1-id",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "forge-blobs" }],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "replace-with-kv-id" }]
}
